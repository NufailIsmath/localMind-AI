# ---------- API ----------
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# REQUIRED: at least 32 random characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d
# Set to false to disable self-service sign-up after creating your account
# first-user (default): sign-up closes after the first (admin) account; admins add people.
# true: always open (handy for demos, but reveals which emails are registered). false: closed.
ALLOW_REGISTRATION=first-user
RATE_LIMIT_ENABLED=true
LOG_LEVEL=info

# ---------- PostgreSQL ----------
DATABASE_URL=postgresql://clbuddy:clbuddy_dev@localhost:5432/clbuddy?schema=public

# ---------- Qdrant ----------
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=documents

# ---------- Ollama ----------
# For `npm run dev`. Docker Compose ignores this and uses DOCKER_OLLAMA_HOST (default: the ollama container).
OLLAMA_HOST=http://localhost:11434
# DOCKER_OLLAMA_HOST=http://host.docker.internal:11434   # Docker + Ollama installed on your computer (e.g. Mac)
# qwen3:8b needs ~16 GB RAM. Use qwen3:4b (or qwen2.5:7b-instruct) on smaller machines.
CHAT_MODEL=qwen3:8b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
# Qwen3 "thinking" adds latency; off by default
OLLAMA_THINK=false
OLLAMA_NUM_CTX=8192
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=180000
EMBEDDING_TIMEOUT_MS=60000

# ---------- RAG ----------
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=100
RETRIEVAL_LIMIT=5
RETRIEVAL_SCORE_THRESHOLD=0.35
MAX_UPLOAD_MB=20
UPLOAD_DIR=./data/uploads

# ---------- Orchestration ----------
MAX_TOOL_ROUNDS=5
MAX_TOOL_CALLS_PER_ROUND=5
TOOL_TIMEOUT_MS=15000
HISTORY_MESSAGE_LIMIT=12

# ---------- Content guardrails ----------
# Blocks explicit content and hate slurs before they reach the model, filters
# the model's answers, and keeps notes professional. See SECURITY.md.
MODERATION_ENABLED=true
# Strong language: warn (answer, mask it, show a reminder) | block | allow
PROFANITY_POLICY=warn
# Extra words, one "category:term" per line (sexual|hate|profanity|insult; "term*" = prefix)
# MODERATION_EXTRA_TERMS_FILE=./config/moderation-terms.txt
# Llama Guard 3, a local safety classifier, checks what the word lists can't
# (harmful requests in clean words, euphemisms, other languages).
# Needs: ollama pull llama-guard3:1b   (about 1.6 GB; llama-guard3:8b is stricter but about 4.9 GB)
MODERATION_GUARD=both            # both (messages + answers) | input | off
GUARD_MODEL=llama-guard3:1b
# Hazard codes to act on (S1-S14 or "all"). Defaults leave out S5 defamation,
# S6 specialised advice, S7 privacy, S8 IP, S13 elections and S14 code abuse,
# which misfire on everyday work questions.
GUARD_CATEGORIES=S1,S2,S3,S4,S9,S10,S11,S12
GUARD_FAIL_MODE=closed           # closed: refuse if the guard is down | open: skip it (logged)
GUARD_TIMEOUT_MS=20000

# ---------- External HR leave system (OFF until its API is ready) ----------
# Leave changes (requests, decisions, cancellations, HR-recorded leave) are
# queued and pushed to this API with retries. See docs/hr-integration.md.
HR_SYNC_ENABLED=false
HR_API_BASE_URL=https://hr-api.example.com/v1
# HR_API_TOKEN=
HR_API_TIMEOUT_MS=10000
HR_SYNC_INTERVAL_MS=15000
HR_SYNC_MAX_ATTEMPTS=8

# ---------- Web ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
