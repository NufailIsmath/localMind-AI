# ---------- API ----------
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# REQUIRED: at least 32 random characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d
# Set to false to disable self-service sign-up after creating your account
# first-user (default): sign-up closes after the first (admin) account; admins add people.
# true: always open (handy for demos, but reveals which emails are registered). false: closed.
ALLOW_REGISTRATION=first-user
RATE_LIMIT_ENABLED=true
LOG_LEVEL=info

# ---------- PostgreSQL ----------
DATABASE_URL=postgresql://clbuddy:clbuddy_dev@localhost:5432/clbuddy?schema=public

# ---------- Qdrant ----------
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=documents

# ---------- Ollama ----------
OLLAMA_HOST=http://localhost:11434
# qwen3:8b needs ~16 GB RAM. Use qwen3:4b (or qwen2.5:7b-instruct) on smaller machines.
CHAT_MODEL=qwen3:8b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
# Qwen3 "thinking" adds latency; off by default
OLLAMA_THINK=false
OLLAMA_NUM_CTX=8192
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=180000
EMBEDDING_TIMEOUT_MS=60000

# ---------- RAG ----------
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=100
RETRIEVAL_LIMIT=5
RETRIEVAL_SCORE_THRESHOLD=0.35
MAX_UPLOAD_MB=20
UPLOAD_DIR=./data/uploads

# ---------- Orchestration ----------
MAX_TOOL_ROUNDS=5
MAX_TOOL_CALLS_PER_ROUND=5
TOOL_TIMEOUT_MS=15000
HISTORY_MESSAGE_LIMIT=12

# ---------- Web ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
