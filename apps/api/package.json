{
  "name": "@clbuddy/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "eval:rag": "tsx --env-file-if-exists=../../.env scripts/eval-rag.ts",
    "mock:ollama": "tsx --env-file-if-exists=../../.env scripts/mock-ollama.ts",
    "seed:demo": "tsx --env-file-if-exists=../../.env scripts/seed-demo.ts",
    "reindex:all": "tsx --env-file-if-exists=../../.env scripts/reindex-all.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.4.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/jwt": "10.2.9",
    "@fastify/multipart": "10.1.9",
    "@fastify/rate-limit": "11.3.0",
    "@clbuddy/shared": "0.1.0",
    "@qdrant/js-client-rest": "1.15.1",
    "fastify": "5.12.8",
    "mammoth": "1.13.0",
    "unpdf": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "docx": "9.16.0",
    "tsx": "4.23.15",
    "vitest": "5.1.1"
  }
}
