// CL Buddy relational data model.
//
// PostgreSQL is the system of record for users, documents, conversations and
// the tool audit trail. Chunk *content* and embeddings live in Qdrant; the
// DocumentChunk table only keeps the bookkeeping needed to locate, cite and
// delete those vectors.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

/// Sensitivity of a document, and the maximum sensitivity a user may read.
/// Ordered: PUBLIC < INTERNAL < CONFIDENTIAL < RESTRICTED.
enum Classification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

/// Who a document is shared with (the owner can always read it).
enum DocumentVisibility {
  PRIVATE
  ORGANIZATION
  GROUPS
}

enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  DENIED
}

enum LeaveType {
  ANNUAL
  SICK
  PARENTAL
  UNPAID
  OTHER
}

/// APPROVED entries count against the balance; PENDING requests are shown
/// separately (and reserve days so they can't be double-booked).
enum LeaveEntryStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveEntrySource {
  MANUAL
  IMPORT
  REQUEST
}

enum ToolExecutionStatus {
  SUCCESS
  ERROR
  DENIED
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique
  passwordHash String
  role         UserRole       @default(USER)
  /// Highest document classification this user may read when it is shared with them
  clearance    Classification @default(INTERNAL)
  createdAt    DateTime       @default(now())

  conversations   Conversation[]
  documents       Document[]
  memberships     GroupMembership[]
  auditEvents     AuditEvent[]
  documentGrants  DocumentUserAccess[] @relation("grantee")
  accessRequests  AccessRequest[]      @relation("requester")
  decidedRequests AccessRequest[]      @relation("decider")
  leaveAllowances LeaveAllowance[]
  leaveEntries    LeaveEntry[]
}

/// An individual grant (e.g. an approved access request). Clearance still applies.
model DocumentUserAccess {
  documentId  String   @db.Uuid
  userId      String   @db.Uuid
  grantedById String?  @db.Uuid
  createdAt   DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation("grantee", fields: [userId], references: [id], onDelete: Cascade)

  @@id([documentId, userId])
  @@index([userId])
}

/// "Can I see that?" — raised from a restricted-content notice in a chat answer.
model AccessRequest {
  id          String              @id @default(uuid()) @db.Uuid
  documentId  String              @db.Uuid
  requesterId String              @db.Uuid
  /// Chat message + notice the request was raised from
  messageId   String?             @db.Uuid
  noticeId    String?
  note        String?
  status      AccessRequestStatus @default(PENDING)
  decidedById String?             @db.Uuid
  decidedAt   DateTime?
  createdAt   DateTime            @default(now())

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  requester User     @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  decidedBy User?    @relation("decider", fields: [decidedById], references: [id], onDelete: SetNull)
  message   Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([documentId, status])
  @@index([requesterId, createdAt])
}

/// A team/department documents can be shared with (e.g. HR, Executives).
model Group {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  members   GroupMembership[]
  documents DocumentGroupAccess[]
}

model GroupMembership {
  userId    String   @db.Uuid
  groupId   String   @db.Uuid
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@index([groupId])
}

model DocumentGroupAccess {
  documentId String @db.Uuid
  groupId    String @db.Uuid

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([documentId, groupId])
  @@index([groupId])
}

/// Security-relevant changes: sharing, classification, groups, clearances.
model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  targetType String
  targetId   String
  details    Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([targetType, targetId])
}

model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       Message[]
  toolExecutions ToolExecution[]

  @@index([userId, updatedAt])
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @db.Uuid
  role           MessageRole
  content        String
  /// Citations attached to an assistant answer (Source[] from @clbuddy/shared)
  sources        Json?
  /// Restricted-content notices (server-side; includes document ids never sent to clients)
  restricted     Json?
  /// Actions the assistant prepared for the user to confirm (e.g. a leave request)
  actions        Json?
  /// Content-guardrail notice shown with an answer (ModerationNoticeDto)
  moderation     Json?
  createdAt      DateTime    @default(now())

  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  toolExecutions ToolExecution[]
  accessRequests AccessRequest[]

  @@index([conversationId, createdAt])
}

model Document {
  id                      String             @id @default(uuid()) @db.Uuid
  userId                  String             @db.Uuid
  filename                String
  mimeType                String
  sizeBytes               Int
  /// sha256 of the uploaded bytes, used to reject duplicate uploads
  contentHash             String
  status                  DocumentStatus     @default(PENDING)
  visibility              DocumentVisibility @default(PRIVATE)
  classification          Classification     @default(INTERNAL)
  /// Classification suggested by the classifier after indexing (only kept when higher than `classification`)
  suggestedClassification Classification?
  /// Human-readable reasons for the suggestion
  suggestionReasons       Json?
  error                   String?
  pageCount               Int?
  chunkCount              Int                @default(0)
  /// Embedding model used to index this document (re-index when it changes)
  embeddingModel          String?
  uploadedAt              DateTime           @default(now())
  indexedAt               DateTime?

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks         DocumentChunk[]
  groupAccess    DocumentGroupAccess[]
  userAccess     DocumentUserAccess[]
  accessRequests AccessRequest[]

  @@unique([userId, contentHash])
  @@index([visibility, status])
  @@index([userId, uploadedAt])
  @@index([status])
}

model DocumentChunk {
  id         String @id @default(uuid()) @db.Uuid
  documentId String @db.Uuid
  chunkIndex Int
  /// Qdrant point id
  vectorId   String @unique @db.Uuid
  pageStart  Int?
  pageEnd    Int?
  tokenCount Int

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
}

model ToolExecution {
  id             String              @id @default(uuid()) @db.Uuid
  conversationId String              @db.Uuid
  /// Assistant message produced by the turn that ran this tool
  messageId      String?             @db.Uuid
  toolName       String
  arguments      Json
  status         ToolExecutionStatus
  error          String?
  durationMs     Int
  createdAt      DateTime            @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([messageId])
  @@index([toolName, createdAt])
}

/// A person's leave allowance for one year and leave type. All amounts are in
/// HALF-DAY units (Int) so half days add up exactly: 21 days = 42.
model LeaveAllowance {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @db.Uuid
  year               Int
  leaveType          LeaveType
  entitledHalfDays   Int
  carriedHalfDays    Int       @default(0)
  /// Carried-over days not used by this date are forfeited
  carryOverExpiresOn DateTime? @db.Date
  /// Manual corrections (+/-), e.g. bought or gifted days
  adjustmentHalfDays Int       @default(0)
  note               String?
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, leaveType])
}

/// Leave taken or booked. Days default to working days in the range
/// (weekends and company holidays excluded) but can be overridden (half days).
model LeaveEntry {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @db.Uuid
  leaveType    LeaveType
  startDate    DateTime         @db.Date
  endDate      DateTime         @db.Date
  halfDays     Int
  status       LeaveEntryStatus @default(APPROVED)
  source       LeaveEntrySource @default(MANUAL)
  note         String?
  createdById  String?          @db.Uuid
  createdAt    DateTime         @default(now())
  /// Approval workflow (requests made in the app)
  decidedById  String?          @db.Uuid
  decidedAt    DateTime?
  decisionNote String?
  /// "messageId:actionId" of the chat card the request was submitted from
  actionRef    String?
  /// The id the external HR system gave this leave (set after the first sync)
  externalId   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startDate])
  @@index([status, startDate])
}

/// Company holidays (not counted as leave days).
model CompanyHoliday {
  id   String   @id @default(uuid()) @db.Uuid
  date DateTime @unique @db.Date
  name String
}

enum HrSyncStatus {
  PENDING
  SENT
  FAILED
}

/// Outbox of leave changes to push to the external HR leave system. Written in
/// the same transaction as the change; delivered in order, with retries.
model HrSyncEvent {
  id            String       @id @default(uuid()) @db.Uuid
  entryId       String       @db.Uuid
  eventType     String
  payload       Json
  status        HrSyncStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?
  nextAttemptAt DateTime     @default(now())
  sentAt        DateTime?
  createdAt     DateTime     @default(now())

  @@index([status, nextAttemptAt])
  @@index([entryId, createdAt])
}
